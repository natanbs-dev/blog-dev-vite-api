# /etc/barbosa-api.env  (chmod 600, dono root)
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
DATABASE_URL=postgres://barbosa:TROQUE_A_SENHA_DO_BANCO@127.0.0.1:5432/barbosa
SITE_URL=https://barbosa-md.pages.dev
# openssl rand -hex 32 — o MESMO valor vai no Cloudflare Pages
PROXY_SECRET=
# Brevo: Settings → SMTP & API → SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# o remetente precisa estar verificado no Brevo (Senders)
MAIL_FROM="barbosa.md <seu-email-verificado@exemplo.com>"
