# Copie para .env e ajuste. Nunca faça commit do .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Postgres (em dev: o container do compose.yaml)
DATABASE_URL=postgres://barbosa:barbosa@localhost:5432/barbosa

# Endereço do blog. Em dev é o Vite; em produção, o Cloudflare Pages.
# Usado para checar a origem das requisições e montar os links dos e-mails.
SITE_URL=http://localhost:5173

# Segredo compartilhado com o proxy (Vite em dev, Cloudflare em produção).
# Gere com: openssl rand -hex 32
PROXY_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres

# E-mail. Em dev, o Mailpit (http://localhost:8025 mostra as mensagens).
# Em produção, o SMTP do Brevo: smtp-relay.brevo.com, porta 587.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="barbosa.md <nao-responda@exemplo.com>"
